            android:shadowDy="0" />
        <Button android:id="@+id/btn21"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />
        <Button android:id="@+id/btn22"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />
    </GridLayout>

    <Button
        android:id="@+id/btnReset"
        android:layout_width="240dp"
        android:layout_height="55dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/neon_button_bg"
        android:text="НАЧАТЬ ЗАНОВО"
        android:textColor="#FF00FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:shadowColor="#FF00FF"
        android:shadowRadius="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gridLayout" />

    <Button
        android:id="@+id/btnAuthors"
        android:layout_width="240dp"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/neon_button_bg"
        android:text="ОБ АВТОРАХ"
        android:textColor="#FF00FF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:shadowColor="#FF00FF"
        android:shadowRadius="10"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
