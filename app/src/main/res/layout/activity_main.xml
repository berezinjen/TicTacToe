<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/statusLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ход: "
            android:textColor="#AAAAAA"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvCurrentPlayer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X"
            android:textColor="#39FF14"
            android:textSize="36sp"
            android:textStyle="bold" />
    </LinearLayout>

    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="330dp"
        android:layout_height="330dp"
        android:layout_marginTop="40dp"
        android:columnCount="3"
        android:rowCount="3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/statusLayout">

        <Button android:id="@+id/btn00"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />
        <Button android:id="@+id/btn01"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />
        <Button android:id="@+id/btn02"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />
        <Button android:id="@+id/btn10"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />
        <Button android:id="@+id/btn11"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:background="@drawable/cell_bg"
            android:text=""
            android:textSize="60sp"
            android:textStyle="bold"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:shadowColor="#39FF14"
            android:shadowRadius="15"
