<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A1128"
    android:padding="32dp"
    tools:context=".AuthorsActivity">

    <TextView
        android:id="@+id/tvAuthorsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ОБ АВТОРАХ"
        android:textColor="#FF00FF"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="#FF00FF"
        android:shadowRadius="15"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="64dp"/>

    <TextView
        android:id="@+id/tvUniInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Студенты ВГУВТ\nГруппа: ЗИСТ-3"
        android:textColor="#AAAAAA"
        android:textSize="18sp"
        android:textAlignment="center"
        android:lineSpacingExtra="8dp"
        android:layout_marginTop="40dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvAuthorsTitle" />

    <!-- Уменьшили свечение (radius=8) и убрали bold, чтобы не слипалось -->
    <TextView
        android:id="@+id/tvNames"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Березин Евгений\nКлячин Аркадий"
        android:textColor="#FFEA00"
        android:textSize="26sp"
        android:textAlignment="center"
        android:lineSpacingExtra="10dp"
        android:shadowColor="#FFEA00"
        android:shadowRadius="8"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvUniInfo" />

    <TextView
        android:id="@+id/tvProjectInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Курсовая работа\nпо разработке мобильных приложений"
        android:textColor="#AAAAAA"
        android:textSize="16sp"
        android:textAlignment="center"
        android:lineSpacingExtra="6dp"
        android:layout_marginTop="32dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNames" />

    <Button
        android:id="@+id/btnBack"
        android:layout_width="240dp"
        android:layout_height="55dp"
        android:text="НАЗАД"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#FF00FF"
        android:shadowColor="#FF00FF"
        android:shadowRadius="10"
        android:background="@drawable/neon_button_bg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="64dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>